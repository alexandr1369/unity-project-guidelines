{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/runtime/scripts/agent-hooks/run-installed.py\" prompt-reminders.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/runtime/scripts/agent-hooks/run-installed.py\" commit-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/runtime/scripts/agent-hooks/run-installed.py\" verify-builds.sh",
            "if": "Bash(git *push*)",
            "timeout": 600,
            "statusMessage": "Собираю csproj проекта перед push..."
          }
        ]
      },
      {
        "matcher": "mcp__unityMCP__execute_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/runtime/scripts/agent-hooks/run-installed.py\" mcp-long-command-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/runtime/scripts/agent-hooks/run-installed.py\" pr-description-reminder.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*trello.*|mcp__claude-in-chrome__navigate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/runtime/scripts/agent-hooks/run-installed.py\" gd-card-reminder.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
